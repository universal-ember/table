{
  "extends": "@tsconfig/ember/tsconfig.json",
  "compilerOptions": {
    "noEmitOnError": false,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,

    // stylistic
    "noPropertyAccessFromIndexSignature": false,
    "types": [
      "vite/client",
      "@embroider/core/virtual",
      "ember-source/types",
      "kolay/virtual"
    ]
  },
  "contentMappers": [
    {
      "package": "ember-content-mapper",
      "extensions": [".gts", ".gjs"]
    }
  ]
}
